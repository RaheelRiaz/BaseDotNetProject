@{
    ViewData["Title"] = "Access Denied";
    Layout = "_AdminLayout";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card card-danger text-center">
            <div class="card-body py-5">
                <i class="fas fa-ban fa-4x text-danger mb-3"></i>
                <h2>Access Denied</h2>
                <p class="text-muted">You do not have permission to access this resource.</p>
                <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary mt-2">
                    <i class="fas fa-home mr-1"></i> Go to Dashboard
                </a>
            </div>
        </div>
    </div>
</div>
