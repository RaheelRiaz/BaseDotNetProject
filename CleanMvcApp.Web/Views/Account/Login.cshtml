@model CleanMvcApp.Web.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Login";
    Layout = "_Layout";
}

<div class="login-box">
    <div class="login-logo">
        <a href="#"><b>Clean</b>MvcApp</a>
    </div>
    <div class="card">
        <div class="card-body login-card-body">
            <p class="login-box-msg">Sign in to start your session</p>

            <form asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="input-group mb-3">
                    <input asp-for="Email" class="form-control" placeholder="Email" autofocus />
                    <div class="input-group-append">
                        <div class="input-group-text"><span class="fas fa-envelope"></span></div>
                    </div>
                    <span asp-validation-for="Email" class="text-danger small w-100"></span>
                </div>

                <div class="input-group mb-3">
                    <input asp-for="Password" class="form-control" placeholder="Password" />
                    <div class="input-group-append">
                        <div class="input-group-text"><span class="fas fa-lock"></span></div>
                    </div>
                    <span asp-validation-for="Password" class="text-danger small w-100"></span>
                </div>

                <div class="row">
                    <div class="col-8">
                        <div class="icheck-primary">
                            <input asp-for="RememberMe" type="checkbox" id="remember" />
                            <label for="remember">Remember Me</label>
                        </div>
                    </div>
                    <div class="col-4">
                        <button type="submit" class="btn btn-primary btn-block">Sign In</button>
                    </div>
                </div>
            </form>

            <p class="mb-1 mt-3">
                <a asp-action="ForgotPassword">I forgot my password</a>
            </p>
            <p class="mb-0">
                <a asp-action="Register" class="text-center">Register a new membership</a>
            </p>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
