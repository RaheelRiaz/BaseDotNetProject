@{
    ViewData["Title"] = "Forgot Password Confirmation";
    Layout = "_Layout";
}

<div class="login-box">
    <div class="login-logo">
        <a href="#"><b>Clean</b>MvcApp</a>
    </div>
    <div class="card">
        <div class="card-body login-card-body">
            <p class="login-box-msg">@ViewBag.Message</p>
            @if (ViewBag.ResetUrl != null)
            {
                <div class="alert alert-info">
                    <strong>Demo Reset URL:</strong><br />
                    <a href="@ViewBag.ResetUrl">@ViewBag.ResetUrl</a>
                </div>
            }
            <p class="mt-3">
                <a asp-action="Login">Back to Login</a>
            </p>
        </div>
    </div>
</div>
