@model IEnumerable<CleanMvcApp.Web.ViewModels.ProductViewModel>
@{
    ViewData["Title"] = "Products";
    Layout = "_AdminLayout";
}

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">
                    <i class="fas fa-box mr-2"></i>Product List
                </h3>
                @if (User.IsInRole("Admin"))
                {
                    <div class="card-tools">
                        <a asp-action="Create" class="btn btn-primary btn-sm">
                            <i class="fas fa-plus mr-1"></i> Add Product
                        </a>
                    </div>
                }
            </div>
            <div class="card-body table-responsive p-0">
                @if (!Model.Any())
                {
                    <div class="p-4 text-center text-muted">
                        <i class="fas fa-box-open fa-3x mb-2"></i>
                        <p>No products found.</p>
                    </div>
                }
                else
                {
                    <table class="table table-hover text-nowrap">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Name</th>
                                <th>Description</th>
                                <th>Price</th>
                                <th>Created</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var product in Model)
                            {
                                <tr>
                                    <td>@product.Id</td>
                                    <td>@product.Name</td>
                                    <td>@(product.Description.Length > 60 ? product.Description.Substring(0, 60) + "..." : product.Description)</td>
                                    <td>$@product.Price.ToString("F2")</td>
                                    <td>@product.CreatedDate.ToString("MMM dd, yyyy")</td>
                                    <td>
                                        <a asp-action="Details" asp-route-id="@product.Id"
                                           class="btn btn-info btn-xs">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        @if (User.IsInRole("Admin"))
                                        {
                                            <a asp-action="Edit" asp-route-id="@product.Id"
                                               class="btn btn-warning btn-xs">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@product.Id"
                                               class="btn btn-danger btn-xs">
                                                <i class="fas fa-trash"></i>
                                            </a>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>
</div>
