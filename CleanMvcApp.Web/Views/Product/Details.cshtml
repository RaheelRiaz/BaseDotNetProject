@model CleanMvcApp.Web.ViewModels.ProductViewModel
@{
    ViewData["Title"] = "Product Details";
    Layout = "_AdminLayout";
}

<div class="row">
    <div class="col-md-8 col-lg-6">
        <div class="card card-info">
            <div class="card-header">
                <h3 class="card-title">
                    <i class="fas fa-info-circle mr-2"></i>Product Details
                </h3>
            </div>
            <div class="card-body">
                <table class="table table-bordered">
                    <tr>
                        <th style="width:150px">ID</th>
                        <td>@Model.Id</td>
                    </tr>
                    <tr>
                        <th>Name</th>
                        <td>@Model.Name</td>
                    </tr>
                    <tr>
                        <th>Description</th>
                        <td>@Model.Description</td>
                    </tr>
                    <tr>
                        <th>Price</th>
                        <td><strong>$@Model.Price.ToString("F2")</strong></td>
                    </tr>
                    <tr>
                        <th>Created Date</th>
                        <td>@Model.CreatedDate.ToString("MMMM dd, yyyy HH:mm")</td>
                    </tr>
                </table>
            </div>
            <div class="card-footer">
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="fas fa-arrow-left mr-1"></i> Back to List
                </a>
                @if (User.IsInRole("Admin"))
                {
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning ml-2">
                        <i class="fas fa-edit mr-1"></i> Edit
                    </a>
                    <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger ml-2">
                        <i class="fas fa-trash mr-1"></i> Delete
                    </a>
                }
            </div>
        </div>
    </div>
</div>
