@model CleanMvcApp.Web.ViewModels.ProductViewModel
@{
    ViewData["Title"] = "Delete Product";
    Layout = "_AdminLayout";
}

<div class="row">
    <div class="col-md-8 col-lg-6">
        <div class="card card-danger">
            <div class="card-header">
                <h3 class="card-title">
                    <i class="fas fa-trash mr-2"></i>Confirm Delete
                </h3>
            </div>
            <div class="card-body">
                <div class="alert alert-warning">
                    <i class="fas fa-exclamation-triangle mr-2"></i>
                    Are you sure you want to delete this product? This action cannot be undone.
                </div>
                <table class="table table-bordered">
                    <tr>
                        <th style="width:150px">ID</th>
                        <td>@Model.Id</td>
                    </tr>
                    <tr>
                        <th>Name</th>
                        <td>@Model.Name</td>
                    </tr>
                    <tr>
                        <th>Price</th>
                        <td>$@Model.Price.ToString("F2")</td>
                    </tr>
                    <tr>
                        <th>Created Date</th>
                        <td>@Model.CreatedDate.ToString("MMMM dd, yyyy")</td>
                    </tr>
                </table>
            </div>
            <div class="card-footer">
                <form asp-action="Delete" method="post">
                    @Html.AntiForgeryToken()
                    <input name="id" value="@Model.Id" type="hidden" />
                    <button type="submit" class="btn btn-danger">
                        <i class="fas fa-trash mr-1"></i> Yes, Delete
                    </button>
                    <a asp-action="Index" class="btn btn-secondary ml-2">
                        <i class="fas fa-times mr-1"></i> Cancel
                    </a>
                </form>
            </div>
        </div>
    </div>
</div>
